---
import ForestExperience from "@/components/ForestExperience.astro"
import OrbList from "@/components/OrbList.astro"
import OrbModal from "@/components/OrbModal.astro"
import { FOG_COLOR } from "@/experience/world/world.constants"

const pageTitle = "Forest"
const pageDescription = "スクロールで小さな星の森を歩く 3D サイト"
---

<!doctype html>
<html lang="ja" style={`--fog-color: ${FOG_COLOR}`}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={pageDescription} />
    <title>{pageTitle}</title>
  </head>
  <body>
    <h1 class="visually-hidden">Forest — 小さな星の森を歩くサイト</h1>
    <ForestExperience />
    {/* OrbList は 3D を起動できなかったときに ForestExperience の状態を見て表示するため、その後ろに置く */}
    <OrbList />
    {/* <dialog> は最前面（top layer）に描かれるため z-index は要らない */}
    <OrbModal />
  </body>
</html>

<style>
  :global(*) {
    box-sizing: border-box;
  }

  /* ページ自体はスクロールさせず、ホイール・タッチはすべて 3D 空間の移動に使う */
  :global(html),
  :global(body) {
    height: 100%;
    margin: 0;
    overflow: hidden;
    overscroll-behavior: none;
  }

  /* HTML の UI（モーダル・一覧）で共通に使う色 */
  :global(:root) {
    /* 文字の色 */
    --color-text: #f2f5ef;
    /* 森の上に重ねるパネルの背景（暗い緑。背面の森が少し透ける） */
    --color-surface: rgb(16 24 22 / 0.92);
    /* キーボード操作のフォーカスリング（水色の炎に合わせる） */
    --color-focus: #9fe7ff;
  }

  /* 背景を霧の色にしておき、初期化前やリサイズ中も 3D 空間と色がつながるようにする */
  :global(body) {
    background: var(--fog-color);
    color: var(--color-text);
    font-family: system-ui, sans-serif;
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
</style>
