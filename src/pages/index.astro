---
import ForestExperience from "@/components/ForestExperience.astro"
import { FOG_COLOR } from "@/experience/world/world.constants"

const pageTitle = "Forest"
const pageDescription = "スクロールで小さな星の森を歩く 3D サイト"
---

<!doctype html>
<html lang="ja" style={`--fog-color: ${FOG_COLOR}`}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={pageDescription} />
    <title>{pageTitle}</title>
  </head>
  <body>
    <h1 class="visually-hidden">Forest — 小さな星の森を歩くサイト</h1>
    <ForestExperience />
  </body>
</html>

<style>
  :global(*) {
    box-sizing: border-box;
  }

  /* ページ自体はスクロールさせず、ホイール・タッチはすべて 3D 空間の移動に使う */
  :global(html),
  :global(body) {
    height: 100%;
    margin: 0;
    overflow: hidden;
    overscroll-behavior: none;
  }

  /* 背景を霧の色にしておき、初期化前やリサイズ中も 3D 空間と色がつながるようにする */
  :global(body) {
    background: var(--fog-color);
    color: #f2f5ef;
    font-family: system-ui, sans-serif;
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
</style>
