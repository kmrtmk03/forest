---
/**
 * キーボード・スクリーンリーダー用のオーブ一覧（計画書 §14-3）。
 * canvas の中のオーブはキーボードで選べないため、同じモーダルを開くボタンを並べる。
 * 普段は見えないようにし、Tab でフォーカスが入ったときだけ表示する。
 * 3D を起動できなかったとき（<forest-experience data-state="error">）は常に表示し、コンテンツへたどり着けるようにする。
 */
import { ORB_CONTENTS } from "@/data/orbs.data"
---

<orb-list>
  <nav class="list" aria-labelledby="orb-list-heading">
    <h2 id="orb-list-heading" class="heading">
      オーブの一覧
    </h2>
    <ul class="items">
      {ORB_CONTENTS.map(({ id, label, title }) => (
        <li>
          <button type="button" class="item" data-orb-id={id}>
            {label}: {title}
          </button>
        </li>
      ))}
    </ul>
  </nav>
</orb-list>

<script>
  import { dispatchOrbSelect } from "@/experience/orbs/orb.events"
  import { isOrbId } from "@/experience/orbs/orbMarker.utils"

  /**
   * 一覧のボタンが押されたら、3D 上のクリックと同じ forest:orb-select を発火する（モーダルは OrbModal が開く）。
   * リスナーは要素 1 つにまとめ（イベント委譲）、disconnectedCallback で外す。
   */
  class OrbListElement extends HTMLElement {
    private abortController: AbortController | null = null

    connectedCallback(): void {
      this.abortController = new AbortController()
      this.addEventListener("click", this.handleClick, { signal: this.abortController.signal })
    }

    disconnectedCallback(): void {
      this.abortController?.abort()
      this.abortController = null
    }

    private readonly handleClick = (event: MouseEvent): void => {
      if (!(event.target instanceof Element)) return
      const button = event.target.closest<HTMLButtonElement>("button[data-orb-id]")
      if (!button) return

      // data 属性は HTML を経由するため型の保証がない。形が崩れていたら原因が分かるように例外にする
      const { orbId } = button.dataset
      if (!isOrbId(orbId)) throw new Error(`OrbList: オーブ ID の形が正しくありません（${orbId}）`)
      dispatchOrbSelect(orbId)
    }
  }

  // 同じページで二重に定義すると例外になるため、未定義のときだけ登録する
  if (!customElements.get("orb-list")) {
    customElements.define("orb-list", OrbListElement)
  }
</script>

<style>
  orb-list {
    position: fixed;
    z-index: 1;
    bottom: 1rem;
    left: 1rem;
    display: block;
    max-width: calc(100% - 2rem);
  }

  /* 普段は見えないようにする（スクリーンリーダーには読まれる） */
  .list {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  /*
   * 一覧の中にフォーカスがあるとき、または 3D を起動できなかったときは表示する。
   * forest-experience は index.astro でこの要素より前に置く兄弟要素
   */
  orb-list:focus-within .list,
  :global(forest-experience[data-state="error"]) ~ orb-list .list {
    position: static;
    width: auto;
    height: auto;
    padding: 0.75rem 1rem;
    overflow: visible;
    border-radius: 0.75rem;
    background: rgb(16 24 22 / 0.9);
    clip-path: none;
    white-space: normal;
  }

  .heading {
    margin: 0 0 0.5rem;
    font-size: 0.875rem;
  }

  .items {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .item {
    padding: 0.5rem 0.75rem;
    border: 1px solid rgb(255 255 255 / 0.2);
    border-radius: 0.5rem;
    background: rgb(255 255 255 / 0.06);
    color: inherit;
    font: inherit;
    font-size: 0.875rem;
    cursor: pointer;
  }

  .item:hover {
    background: rgb(255 255 255 / 0.14);
  }

  .item:focus-visible {
    outline: 2px solid #9fe7ff;
    outline-offset: 2px;
  }
</style>
